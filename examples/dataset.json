      "prompt": "输出活动提醒JSON，字段为title和channel，其中channel必须为community。",
      "scenario": "内容运营",
      "risk": "low",
      "required": true,
      "checks": [
        {
          "id": "channel",
          "type": "regex",
          "pattern": "\"channel\"\\s*:\\s*\"community\"",
          "label": "包含指定渠道字段"
        },
        {
          "id": "title",
          "type": "contains",
          "value": "\"title\"",
          "label": "\"title\""
        }
      ]
