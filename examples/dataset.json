{
  "schemaVersion": 1,
  "id": "synthetic-ai-ops-v1",
  "name": "AI 运营常见场景回归集（构造示例）",
  "description": "18个构造案例用于演示评测流程；不是美团/腾讯内部数据、真实用户反馈或真实模型基准。",
  "synthetic": true,
  "policy": {
    "minPassRate": 1,
    "maxRegressions": 0
  },
  "cases": [
    {
      "id": "local-01",
      "prompt": "某门店营业时间为09:00–21:00，周一休息。回答周一是否营业。",
      "scenario": "本地生活商家助手",
      "risk": "low",
      "required": true,
      "checks": [
        {
          "id": "closed",
          "type": "contains",
          "value": "周一休息",
          "label": "周一休息"
        },
        {
          "id": "open",
          "type": "not_contains",
          "value": "周一正常营业",
          "label": "不得出现 周一正常营业"
        }
      ]
    },
    {
      "id": "local-02",
      "prompt": "套餐原价128元，活动价98元。用一句话介绍，不能补充库存和折扣承诺。",
      "scenario": "本地生活商家助手",
      "risk": "medium",
      "required": true,
      "checks": [
        {
          "id": "price",
          "type": "contains",
          "value": "98元",
          "label": "98元"
        },
        {
          "id": "invented-stock",
          "type": "not_contains",
          "value": "仅剩",
          "label": "不得出现 仅剩"
        },
        {
          "id": "guarantee",
          "type": "not_contains",
          "value": "全网最低",
          "label": "不得出现 全网最低"
        }
      ],
      "humanReview": {
        "dimensions": [
          {
            "id": "usefulness",
            "label": "信息有用且不超出给定事实",
            "minScore": 1,
            "maxScore": 5,
            "passScore": 4
          }
        ]
      }
    },
    {
      "id": "local-03",
      "prompt": "顾客询问团购能否退款，但知识库没有退款规则。",
      "scenario": "本地生活商家助手",
      "risk": "medium",
      "required": true,
      "checks": [
        {
          "id": "unknown",
