      "id": "local-04",
      "prompt": "用户问核销GMV如何定义。给定定义：实际完成核销的订单金额；不等于售券金额。",
      "scenario": "本地生活商家助手",
      "risk": "low",
      "required": true,
      "checks": [
        {
          "id": "redeemed",
          "type": "contains",
          "value": "实际完成核销",
          "label": "实际完成核销"
